              </Button>
            ) : (
              <span />
            )}
            <div className="flex items-center gap-2 ml-auto">
              <Button
                type="button"
                variant="secondary"
                onClick={() => onOpenChange(false)}
              >
                Cancel
              </Button>
              <Button type="submit">
                {editingId ? (
                  "Save Changes"
                ) : (
                  <>
                    <Plus className="h-3.5 w-3.5" /> Save Link
                  </>
                )}
              </Button>
            </div>
          </div>
        </form>
        {ConfirmDialogElement}
      </DialogContent>
    </Dialog>
  );
}
