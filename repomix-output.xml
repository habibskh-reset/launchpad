    >
      <div className="w-6 h-6 rounded-md bg-muted flex items-center justify-center flex-shrink-0">
        <img
          src={faviconSrc}
          onError={() => setFaviconSrc(FALLBACK_FAVICON)}
          className="w-3.5 h-3.5 rounded-sm object-contain"
